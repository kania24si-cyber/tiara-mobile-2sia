<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FA"
    tools:context=".Home.pertemuan_9_laporan.NinthActivity">

    <!-- HEADER -->

    <!-- TOOLBAR -->

    <View
        android:id="@+id/background_header"
        android:layout_width="0dp"
        android:layout_height="250dp"
        android:background="@drawable/bg_header_wave"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/transparent"
        app:title=""
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/textApp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="40dp"
        android:text="DesaSface"
        android:textColor="@color/hijau_text"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar" />

    <TextView
        android:id="@+id/textSubApp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Desa Space and Facility"
        android:textColor="@color/hijau_text"
        android:textSize="14sp"
        android:textStyle="bold"
        android:alpha="0.9"
        app:layout_constraintTop_toBottomOf="@id/textApp"
        app:layout_constraintStart_toStartOf="@id/textApp" />


    <!-- SEARCH -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/textInputSearch"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"

        android:layout_width="0dp"
        android:layout_height="wrap_content"

        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="-42dp"

        android:hint="Cari fasilitas desa"

        app:boxBackgroundColor="@android:color/white"

        app:boxCornerRadiusBottomEnd="24dp"
        app:boxCornerRadiusBottomStart="24dp"
        app:boxCornerRadiusTopEnd="24dp"
        app:boxCornerRadiusTopStart="24dp"

        app:boxStrokeWidth="0dp"

        app:layout_constraintTop_toBottomOf="@id/background_header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"

        app:startIconDrawable="@drawable/ic_search"
        app:startIconTint="@color/hijau_primary">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="14dp"
            android:textSize="14sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- BUTTON -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCari"

        android:layout_width="0dp"
        android:layout_height="56dp"

        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="16dp"

        android:text="Cari Fasilitas"
        android:textAllCaps="false"
        android:textSize="15sp"
        android:textStyle="bold"

        app:backgroundTint="@color/hijau_primary"
        app:cornerRadius="18dp"
        app:elevation="6dp"

        app:icon="@drawable/ic_search"
        app:iconTint="@android:color/white"
        app:iconGravity="textStart"
        app:iconPadding="10dp"

        app:layout_constraintTop_toBottomOf="@id/textInputSearch"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- CHIPGROUP -->
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupFilter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:layout_marginTop="18dp"

        app:singleSelection="true"

        app:layout_constraintTop_toBottomOf="@id/btnCari"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- CHIP -->
        <com.google.android.material.chip.Chip
            android:id="@+id/chipFasilitas"
            style="@style/Widget.MaterialComponents.Chip.Filter"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:text="Fasilitas"
            android:textStyle="bold"
            android:textColor="@android:color/white"

            android:checked="true"

            app:chipBackgroundColor="@color/hijau_primary"
            app:chipCornerRadius="16dp" />

        <!-- CHIP -->
        <com.google.android.material.chip.Chip
            android:id="@+id/chipPeminjaman"
            style="@style/Widget.MaterialComponents.Chip.Filter"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:text="Peminjaman"
            android:textStyle="bold"

            app:chipCornerRadius="16dp" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipPembayaran"
            style="@style/Widget.MaterialComponents.Chip.Filter"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:text="Pembayaran"
            android:textStyle="bold"

            app:chipCornerRadius="16dp" />

    </com.google.android.material.chip.ChipGroup>


    <!-- GRID -->

    <TextView
        android:id="@+id/textMenu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:layout_marginStart="24dp"
        android:layout_marginTop="16dp"

        android:text="Layanan Desa"
        android:textColor="@color/hijau_text"
        android:textSize="20sp"
        android:textStyle="bold"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/chipGroupFilter" />

    <androidx.gridlayout.widget.GridLayout
        android:id="@+id/gridMenu"

        android:layout_width="0dp"
        android:layout_height="wrap_content"

        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="12dp"

        android:paddingBottom="12dp"

        app:columnCount="3"

        app:layout_constraintTop_toBottomOf="@id/textMenu"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- MENU 1 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnInfo"

            android:layout_width="102dp"
            android:layout_height="118dp"

            android:layout_margin="4dp"
            android:padding="10dp"

            android:text="Info Aula"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textSize="11sp"
            android:textColor="@android:color/white"

            app:backgroundTint="@color/hijau_primary"
            app:cornerRadius="22dp"
            app:elevation="5dp"

            app:icon="@drawable/ic_info"
            app:iconTint="@android:color/white"
            app:iconGravity="top"
            app:iconPadding="10dp"
            app:iconSize="34dp" />

        <!-- MENU 2 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPinjam"

            android:layout_width="102dp"
            android:layout_height="118dp"

            android:layout_margin="4dp"
            android:padding="10dp"

            android:text="Peminjaman"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textSize="11sp"
            android:textColor="@android:color/white"

            app:backgroundTint="@color/hijau_primary"
            app:cornerRadius="22dp"
            app:elevation="5dp"

            app:icon="@drawable/ic_calendar"
            app:iconTint="@android:color/white"
            app:iconGravity="top"
            app:iconPadding="10dp"
            app:iconSize="34dp" />

        <!-- MENU 3 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBayar"

            android:layout_width="102dp"
            android:layout_height="118dp"

            android:layout_margin="4dp"
            android:padding="10dp"

            android:text="Pembayaran"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textSize="11sp"
            android:textColor="@android:color/white"

            app:backgroundTint="@color/hijau_primary"
            app:cornerRadius="22dp"
            app:elevation="5dp"

            app:icon="@drawable/ic_upload"
            app:iconTint="@android:color/white"
            app:iconGravity="top"
            app:iconPadding="10dp"
            app:iconSize="34dp" />

        <!-- MENU 4 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStatus"

            android:layout_width="102dp"
            android:layout_height="118dp"

            android:layout_margin="4dp"
            android:padding="10dp"

            android:text="Status"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textSize="11sp"
            android:textColor="@android:color/white"

            app:backgroundTint="@color/hijau_primary"
            app:cornerRadius="22dp"
            app:elevation="5dp"

            app:icon="@drawable/ic_status"
            app:iconTint="@android:color/white"
            app:iconGravity="top"
            app:iconPadding="10dp"
            app:iconSize="34dp" />

        <!-- MENU 5 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDownload"

            android:layout_width="102dp"
            android:layout_height="118dp"

            android:layout_margin="4dp"
            android:padding="10dp"

            android:text="Download"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textSize="11sp"
            android:textColor="@android:color/white"

            app:backgroundTint="@color/hijau_primary"
            app:cornerRadius="22dp"
            app:elevation="5dp"

            app:icon="@drawable/ic_download"
            app:iconTint="@android:color/white"
            app:iconGravity="top"
            app:iconPadding="10dp"
            app:iconSize="34dp" />

        <!-- MENU 6 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPetugas"

            android:layout_width="102dp"
            android:layout_height="118dp"

            android:layout_margin="4dp"
            android:padding="10dp"

            android:text="Petugas"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textSize="11sp"
            android:textColor="@android:color/white"

            app:backgroundTint="@color/hijau_primary"
            app:cornerRadius="22dp"
            app:elevation="5dp"

            app:icon="@drawable/ic_profile"
            app:iconTint="@android:color/white"
            app:iconGravity="top"
            app:iconPadding="10dp"
            app:iconSize="34dp" />

    </androidx.gridlayout.widget.GridLayout>

</androidx.constraintlayout.widget.ConstraintLayout>