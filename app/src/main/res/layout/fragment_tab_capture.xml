<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hijau_muda"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <!-- Section Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📷 Kamera Intent"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/hijau_primary"
            android:layout_marginBottom="16dp"
            android:textAlignment="center" />

        <!-- Image Preview Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/putih_soft"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp"
                android:gravity="center">

                <ImageView
                    android:id="@+id/ivCapturedImage"
                    android:layout_width="280dp"
                    android:layout_height="280dp"
                    android:scaleType="centerCrop"
                    android:background="@color/hijau_muda"
                    android:contentDescription="Preview foto yang diambil" />

                <TextView
                    android:id="@+id/tvImagePlaceholder"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Belum ada foto"
                    android:textColor="@color/hijau_dark"
                    android:textSize="13sp"
                    android:layout_marginTop="8dp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Info Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="10dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/putih_soft"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💡 Cara Kerja"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/hijau_primary"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Foto diambil menggunakan Intent kamera sistem dan disimpan langsung ke MediaStore (galeri perangkat) tanpa menggunakan CameraX."
                    android:textColor="@color/hijau_dark"
                    android:textSize="12sp"
                    android:lineSpacingExtra="3dp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Capture Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCapture"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="📸  Ambil Foto"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/putih_soft"
            app:backgroundTint="@color/hijau_primary"
            app:cornerRadius="10dp"
            app:rippleColor="@color/hijau_dark"
            android:layout_marginBottom="8dp" />

    </LinearLayout>

</ScrollView>
