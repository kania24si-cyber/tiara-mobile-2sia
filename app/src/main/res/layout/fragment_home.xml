<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/hijau_muda"
        android:paddingBottom="90dp">

        <!-- WELCOME CARD -->
        <LinearLayout
            android:id="@+id/headerCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:background="@color/hijau_primary"
            android:orientation="vertical"
            android:padding="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/textWelcome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Selamat Datang"
                android:textColor="@color/putih_soft"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textUsername"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Halo, user 👋"
                android:textColor="@color/putih_soft"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- LOGO -->
        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_marginTop="8dp"
            android:src="@drawable/desasface"
            app:layout_constraintTop_toBottomOf="@id/headerCard"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- BUTTON RUMUS -->
        <Button
            android:id="@+id/btnRumus"
            android:layout_width="130dp"
            android:layout_height="95dp"
            android:layout_marginTop="172dp"
            android:backgroundTint="@color/hijau_primary"
            android:text="📐\nRumus"
            android:textColor="@color/putih_soft"
            android:textStyle="bold"
            android:textSize="13sp"
            app:cornerRadius="12dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnCustom1"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintTop_toBottomOf="@id/headerCard" />

        <!-- BUTTON FRAGMENT -->
        <Button
            android:id="@+id/btnCustom1"
            android:layout_width="130dp"
            android:layout_height="95dp"
            android:layout_marginStart="10dp"
            android:backgroundTint="@color/hijau_primary"
            android:text="⭐\nFragment"
            android:textColor="@color/putih_soft"
            android:textStyle="bold"
            android:textSize="13sp"
            app:cornerRadius="12dp"
            app:layout_constraintStart_toEndOf="@id/btnRumus"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/btnRumus" />

        <!-- BUTTON MENU -->
        <Button
            android:id="@+id/btnToNinth"
            android:layout_width="130dp"
            android:layout_height="95dp"
            android:layout_marginTop="14dp"
            android:backgroundTint="@color/hijau_primary"
            android:text="🎨\nMenu"
            android:textColor="@color/putih_soft"
            android:textStyle="bold"
            android:textSize="13sp"
            app:cornerRadius="12dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnBinaDesa"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintTop_toBottomOf="@id/btnRumus" />

        <!-- BUTTON WEB -->
        <Button
            android:id="@+id/btnBinaDesa"
            android:layout_width="130dp"
            android:layout_height="95dp"
            android:layout_marginStart="10dp"
            android:backgroundTint="@color/hijau_primary"
            android:text="🌐\nWeb Desa"
            android:textColor="@color/putih_soft"
            android:textStyle="bold"
            android:textSize="13sp"
            app:cornerRadius="12dp"
            app:layout_constraintStart_toEndOf="@id/btnToNinth"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/btnToNinth" />

        <!-- BUTTON BARU -->

        <!-- LOGOUT -->

        <Button
            android:id="@+id/btnGallery"
            android:layout_width="130dp"
            android:layout_height="95dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/hijau_primary"
            android:text="🖼️\nGaleri"
            android:textColor="@color/putih_soft"
            android:textSize="13sp"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.252"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnToNinth" />

        <Button
            android:id="@+id/btnLogout"
            android:layout_width="140dp"
            android:layout_height="48dp"
            android:layout_marginTop="32dp"
            android:backgroundTint="@color/hijau_dark"
            android:text="Logout"
            android:textColor="@color/putih_soft"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            app:layout_constraintTop_toBottomOf="@id/btnGallery"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>