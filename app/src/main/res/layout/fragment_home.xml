<?xml version="1.0" encoding="utf-8"?>


<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/hijau_muda">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent">

        <!-- HEADER -->
        <!-- HEADER -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/headerCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="@color/hijau_primary"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/textWelcome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Selamat Datang"
                    android:textColor="@color/putih_soft"
                    android:textSize="22sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/textUsername"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Halo, User 👋"
                    android:textColor="@color/putih_soft"
                    android:textSize="14sp"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- LOGO -->
        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_marginTop="20dp"
            android:src="@drawable/desasface"
            app:layout_constraintTop_toBottomOf="@id/headerCard"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- BARIS 1 -->

        <Button
            android:id="@+id/btnRumus"
            android:layout_width="100dp"
            android:layout_height="65dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/hijau_primary"
            android:text="📐\nRumus"
            android:textColor="@color/putih_soft"
            android:textSize="11sp"
            android:textStyle="bold"
            app:cornerRadius="10dp"
            app:layout_constraintTop_toBottomOf="@id/imgLogo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnCustom1"
            app:layout_constraintHorizontal_chainStyle="packed"/>

        <Button
            android:id="@+id/btnCustom1"
            android:layout_width="100dp"
            android:layout_height="65dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/hijau_primary"
            android:text="⭐\nFragment"
            android:textColor="@color/putih_soft"
            android:textSize="11sp"
            android:textStyle="bold"
            app:cornerRadius="10dp"
            app:layout_constraintTop_toTopOf="@id/btnRumus"
            app:layout_constraintStart_toEndOf="@id/btnRumus"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- BARIS 2 -->

        <Button
            android:id="@+id/btnToNinth"
            android:layout_width="100dp"
            android:layout_height="65dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/hijau_primary"
            android:text="🎨\nMenu"
            android:textColor="@color/putih_soft"
            android:textSize="11sp"
            android:textStyle="bold"
            app:cornerRadius="10dp"
            app:layout_constraintTop_toBottomOf="@id/btnRumus"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnBinaDesa"
            app:layout_constraintHorizontal_chainStyle="packed"/>

        <Button
            android:id="@+id/btnBinaDesa"
            android:layout_width="100dp"
            android:layout_height="65dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/hijau_primary"
            android:text="🌐\nWeb Desa"
            android:textColor="@color/putih_soft"
            android:textSize="11sp"
            android:textStyle="bold"
            app:cornerRadius="10dp"
            app:layout_constraintTop_toTopOf="@id/btnToNinth"
            app:layout_constraintStart_toEndOf="@id/btnToNinth"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- BARIS 3 -->

        <Button
            android:id="@+id/btnGallery"
            android:layout_width="100dp"
            android:layout_height="65dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/hijau_primary"
            android:text="🖼️\nGaleri"
            android:textColor="@color/putih_soft"
            android:textSize="11sp"
            android:textStyle="bold"
            app:cornerRadius="10dp"
            app:layout_constraintTop_toBottomOf="@id/btnToNinth"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnKamera"
            app:layout_constraintHorizontal_chainStyle="packed"/>

        <Button
            android:id="@+id/btnKamera"
            android:layout_width="100dp"
            android:layout_height="65dp"
            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/hijau_primary"
            android:text="📷\nKamera"
            android:textColor="@color/putih_soft"
            android:textSize="11sp"
            android:textStyle="bold"
            app:cornerRadius="10dp"
            app:layout_constraintTop_toTopOf="@id/btnGallery"
            app:layout_constraintStart_toEndOf="@id/btnGallery"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- LOGOUT -->

        <Button
            android:id="@+id/btnLogout"
            android:layout_width="130dp"
            android:layout_height="42dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/hijau_dark"
            android:text="Logout"
            android:textColor="@color/putih_soft"
            android:textSize="13sp"
            android:textStyle="bold"
            app:cornerRadius="10dp"
            app:layout_constraintTop_toBottomOf="@id/btnGallery"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- JUDUL BERITA -->

        <TextView
            android:id="@+id/tvBerita"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="📰 Berita Desa Terkini"
            android:textColor="@color/hijau_text"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/btnLogout"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- RECYCLERVIEW BERITA -->

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvNews"
            android:layout_width="0dp"
            android:layout_height="450dp"
            android:layout_marginTop="10dp"
            android:padding="8dp"
            app:layout_constraintTop_toBottomOf="@id/tvBerita"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>