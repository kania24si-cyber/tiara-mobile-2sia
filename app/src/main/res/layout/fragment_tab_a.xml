<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hijau_muda">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- JUDUL -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🏛️ Layanan Desa"
                android:textAlignment="center"
                android:textStyle="bold"
                android:textSize="22sp"
                android:textColor="@color/hijau_primary"
                android:layout_marginBottom="16dp"/>

            <!-- LAYANAN 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/putih_soft"
                android:orientation="vertical"
                android:padding="14dp"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📄 Surat Keterangan"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/hijau_primary"
                    android:layout_marginBottom="4dp"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Pembuatan surat keterangan domisili, usaha, dan keterangan lainnya."
                    android:textColor="@color/hijau_dark"
                    android:textSize="13sp"
                    android:lineSpacingExtra="3dp"/>
            </LinearLayout>

            <!-- LAYANAN 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/putih_soft"
                android:orientation="vertical"
                android:padding="14dp"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔑 Peminjaman Fasilitas"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/hijau_primary"
                    android:layout_marginBottom="4dp"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Pengajuan peminjaman aula, lapangan, dan fasilitas desa lainnya secara online."
                    android:textColor="@color/hijau_dark"
                    android:textSize="13sp"
                    android:lineSpacingExtra="3dp"/>
            </LinearLayout>

            <!-- LAYANAN 3 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/putih_soft"
                android:orientation="vertical"
                android:padding="14dp"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📣 Pengaduan Masyarakat"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/hijau_primary"
                    android:layout_marginBottom="4dp"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Sampaikan aspirasi dan keluhan masyarakat langsung kepada perangkat desa."
                    android:textColor="@color/hijau_dark"
                    android:textSize="13sp"
                    android:lineSpacingExtra="3dp"/>
            </LinearLayout>

            <!-- LAYANAN 4 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/putih_soft"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💰 Informasi Bantuan"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/hijau_primary"
                    android:layout_marginBottom="4dp"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Informasi program bantuan sosial dan pemberdayaan masyarakat desa."
                    android:textColor="@color/hijau_dark"
                    android:textSize="13sp"
                    android:lineSpacingExtra="3dp"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</FrameLayout>